<mxfile host="app.diagrams.net"><diagram id="flow" name="Certification Flow"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s0" value="&lt;b&gt;1. Data export&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HR roster + POS, Payroll, AP&lt;br&gt;SHA-256 hashed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;2. Validation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;validation.py&lt;br&gt;schema, types, duplicates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;3. Risk analysis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;analyzer.py&lt;br&gt;5 checks -&gt; PCI-DSS / NIST&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;4. Packets sent to managers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;generate_packets.py&lt;br&gt;direct reports only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="230" height="90" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;5. Manager decisions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Keep / Revoke + justification&lt;br&gt;process_decisions.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="230" height="90" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;6. Remediation tickets&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;create_tickets.py&lt;br&gt;Jira, no names&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBAD;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="220" width="230" height="90" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;7. Access removed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;IT closes ticket&lt;br&gt;with proof attached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBAD;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="220" width="230" height="90" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;8. Audit evidence retained&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;audit.log, hashes, reports&lt;br&gt;cleanup.py after 90 days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#1F3864;fontColor=#000000;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="230" height="90" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>