# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Use a dedicated free Jira account that can access ONLY this project's board.
# Create the token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=iam-bot@example.com
JIRA_API_TOKEN=replace-with-your-api-token
JIRA_PROJECT_KEY=ARV
JIRA_ISSUE_TYPE=Task
